# Presentation material lives OUTSIDE this repo (../Slide).
# These rules stop a slide build from drifting back in: the deck builder,
# its LaTeX equation cache and the rendered previews are all large and are
# regenerable, and nothing in src/ or tests/ depends on them.
slides/
preview/
_sampleprev/
_tmpl_preview/
results/figures/
*.pptx

# Trained model artifacts (reproduce via scripts instead)
*.pt
*.pth
checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
